DATABASE_URL="postgresql://postgres:postgres@localhost:5432/password_manager?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="change-me-dev-only"
JWT_ACCESS_TTL="15m"
# 32 random bytes, base64-encoded (e.g. `openssl rand -base64 32`). Used to
# encrypt TOTP secrets at rest and as the pepper for KDF-lookup enumeration
# resistance — see server-secret-box.ts and auth.service.ts.
SERVER_SECRET_KEY="change-me-32-bytes-base64-encoded"
STRIPE_SECRET_KEY="sk_test_change_me"
STRIPE_WEBHOOK_SECRET="whsec_change_me"
# Stripe Price IDs for each paid tier (Products/Prices created in the Stripe
# Dashboard) — see billing/stripe-price-map.ts.
STRIPE_PRICE_TEAM_5="price_change_me"
STRIPE_PRICE_TEAM_20="price_change_me"
STRIPE_PRICE_TEAM_100="price_change_me"
# Where Stripe Checkout/Billing Portal redirect back to after a session.
BILLING_SUCCESS_URL="https://example.com/billing/success"
BILLING_CANCEL_URL="https://example.com/billing/cancel"
BILLING_PORTAL_RETURN_URL="https://example.com/billing"
PORT=3000
